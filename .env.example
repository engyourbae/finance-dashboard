# HANYA untuk build/uji lokal (npm run build). Di GitHub, isi lewat:
# Settings > Secrets and variables > Actions > New repository secret.
# JANGAN commit file .env. Isi di bawah hanya placeholder.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Anon / publishable key. JANGAN isi service_role / secret key (build akan menolaknya).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
